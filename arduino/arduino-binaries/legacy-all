void setup() {
  Serial.begin(115200);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(buzzerPin, OUTPUT);
  WiFi.begin(ssid, password);


  while ((WiFi.status() != WL_CONNECTED) || wirelessTimeOut < 5) {
    delay(1000);
    Serial.println("Connecting to WiFi...");
    wirelessTimeOut++;
  }

  if (WiFi.status() != WL_CONNECTED){
    Serial.println("Could not connect to the network, starting in offline mode");
  } else {
    Serial.print("Connected to WiFi in access point:\t");
    Serial.println(ssid);
    Serial.println("");
  }
}

void loop() {


  if (checkForMovement()) {
    unsigned long currentTime = millis();
    if (currentTime - lastPostTime > 10000) { // 10 seconds interval
      // sendPostRequest(1, 1, "Test server");
      Serial.println("Movement detected");
      lastPostTime = currentTime;
    }
  }



  float batteryVoltage = readBatteryVoltage();
  Serial.print("Battery Voltage: ");
  Serial.println(batteryVoltage);

  if (batteryVoltage < 3.3) {
    Serial.println("Battery at critical level");
    for(int i = 0; i < 3; i++) {
      digitalWrite(buzzerPin, HIGH);
      delay(240);
      digitalWrite(buzzerPin, LOW);
      delay(240);
    }
    digitalWrite(buzzerPin, HIGH);
    delay(235);
    digitalWrite(buzzerPin, LOW);
    delay(235);
    digitalWrite(buzzerPin, HIGH);
    delay(235);
    digitalWrite(buzzerPin, LOW);
    delay(235);
    digitalWrite(buzzerPin, HIGH);
    delay(235);
    digitalWrite(buzzerPin, LOW);
    delay(235);
    digitalWrite(buzzerPin, HIGH);
    delay(235);
    digitalWrite(buzzerPin, LOW);
    delay(5000);
  } else digitalWrite(buzzerPin, LOW);

  delay(1500);
}

